# Dịch vụ công cộng chỉ dành cho bản thử nghiệm lưu lượng nhỏ.
# Khi phát hành hãy dùng nhà cung cấp / máy chủ có SLA và tuân thủ chính sách dữ liệu.
VITE_ROUTER_URL=https://router.project-osrm.org
VITE_GEOCODER_URL=https://nominatim.openstreetmap.org
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
VITE_OVERPASS_URL=https://overpass-api.de/api/interpreter

# Google Maps API & PostGIS Backend
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/appdb


{
  "name": "roadlink",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:live": "vitest run --config vitest.live.config.ts",
    "test:e2e": "playwright test",
    "ios:sync": "npm run build && cap sync ios",
    "ios:open": "cap open ios",
    "check": "npm run test && npm run build && npm run test:live && npm run test:e2e"
  },
  "dependencies": {
    "@capacitor-community/bluetooth-le": "^8.4.0",
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/geolocation": "^8.2.5",
    "@capacitor/ios": "^8.6.2",
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "lucide-react": "^0.468.0",
    "maplibre-gl": "^6.19.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vitest": "^3.2.4"
  }
}
